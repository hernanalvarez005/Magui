# Supabase — proyecto (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo server-side. NUNCA con prefijo NEXT_PUBLIC_, nunca en el navegador.
# Se usa exclusivamente en lib/supabase/server.ts (createServiceRoleClient) para
# integraciones server-to-server (ej. POST /api/integrations/web-orders).
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: token compartido para autenticar integraciones externas contra
# /api/integrations/web-orders (ver docs/architecture.md §31).
WEB_ORDERS_API_TOKEN=
